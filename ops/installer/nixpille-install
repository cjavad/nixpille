#!/usr/bin/env fish

# nixpille installer - network-based NixOS installation

set -g STATUS_OK 0
set -g STATUS_CANCEL 1
set -g STATUS_ERROR 2

set -g DIALOG (command -v dialog)
set -g BACKTITLE "nixpille installer"
set -g WORK_DIR "/tmp/nixpille-install"
set -g REMOTE_REPO "https://github.com/cjavad/nixpille"
set -g LOG_DIR "/tmp/nixpille-logs"
set -g LOG_FILE "$LOG_DIR/install.log"

set -g DIALOG_RESULT ""
set -g SELECTED_DISK ""
set -g SELECTED_HOST ""
set -g ENTERED_PASSWORD ""

# --- Logging ---

function log
    mkdir -p $LOG_DIR 2>/dev/null
    echo "["(date '+%H:%M:%S')"] $argv" >> $LOG_FILE
end

function source_env
    # Source bash-style VAR=value env files in fish
    for line in (grep -v '^#' $argv[1] | grep '=')
        set -l key (string split -m1 '=' $line)[1]
        set -l val (string split -m1 '=' $line)[2]
        set -l val (string trim -c '"' $val)
        set -gx $key $val
    end
end

function show_log
    $DIALOG --backtitle "$BACKTITLE" --title "Install Log" --textbox $LOG_FILE 22 78
end

# --- UI Helpers ---

function dialog_run
    set -g DIALOG_RESULT ""
    set -g DIALOG_RESULT ($DIALOG --backtitle "$BACKTITLE" $argv 2>&1 >/dev/tty)
    set -l code $status
    switch $code
        case 0; return $STATUS_OK
        case 1 255; return $STATUS_CANCEL
        case '*'; return $STATUS_ERROR
    end
end

function ui_info
    $DIALOG --backtitle "$BACKTITLE" --infobox "$argv[1]" 5 50
    sleep 1
end

function ui_error
    set -l msg $argv[1]
    if test -f "$LOG_FILE"
        set -l snippet (tail -15 $LOG_FILE 2>/dev/null)
        $DIALOG --backtitle "$BACKTITLE" --title "Error" --msgbox "$msg\n\n$snippet" 20 70
    else
        $DIALOG --backtitle "$BACKTITLE" --title "Error" --msgbox "$msg" 8 50
    end
end

function ui_msg
    $DIALOG --backtitle "$BACKTITLE" --title "$argv[1]" --msgbox "$argv[2]" $argv[3] $argv[4]
end

# --- Network ---

function check_network
    ping -c 1 -W 2 cache.nixos.org &>/dev/null
end

function configure_network
    if check_network
        dialog_run --yesno "Network connected.\n\nReconfigure?" 8 35
        test $status -ne $STATUS_OK; and return $STATUS_OK
    end

    dialog_run --title "Network" --menu "Configure:" 11 45 3 \
        "wifi" "WiFi (nmtui)" \
        "ethernet" "Ethernet (auto)" \
        "skip" "Skip"
    test $status -ne $STATUS_OK; and return $STATUS_CANCEL

    switch $DIALOG_RESULT
        case wifi
            nmtui-connect
        case ethernet
            ui_info "Connecting..."
            nmcli networking on
            sleep 3
            check_network; and ui_info "Connected!"
            or ui_msg "Network" "Connection failed" 7 35
        case skip
            ui_msg "Warning" "Network required for install" 7 40
    end
    return $STATUS_OK
end

# --- Hardware Detection ---

function detect_gpu
    set -l info (lspci 2>/dev/null | grep -iE "vga|3d|display")
    echo $info | grep -iq nvidia; and echo $info | grep -iq intel; and echo "intel-nvidia"; and return
    echo $info | grep -iq nvidia; and echo $info | grep -iqE "amd|radeon"; and echo "amd-nvidia"; and return
    echo $info | grep -iq nvidia; and echo "nvidia"; and return
    echo $info | grep -iqE "amd|radeon"; and echo "amd"; and return
    echo $info | grep -iq intel; and echo "intel"; and return
    echo "unknown"
end

function show_hardware
    set -l cpu (grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | string trim; or echo "?")
    set -l gpu (detect_gpu)
    set -l mem (free -h 2>/dev/null | awk '/^Mem:/{print $2}'; or echo "?")
    set -l disks (lsblk -d -n -o NAME,SIZE,MODEL 2>/dev/null | grep -v loop | head -3 | string join "\n")

    $DIALOG --backtitle "$BACKTITLE" --title "Hardware" \
        --msgbox "CPU: $cpu\nGPU: $gpu\nRAM: $mem\n\nDisks:\n$disks" 14 65
end

function get_default_hostname
    cat /sys/class/dmi/id/product_name 2>/dev/null | tr ' ' '-' | tr '[:upper:]' '[:lower:]'; or echo "nixos"
end

function is_predefined_host
    switch $argv[1]
        case vm ideapad p1gen8
            return 0
        case '*'
            return 1
    end
end

# --- Disk Selection ---

function select_disk
    set -g SELECTED_DISK ""
    set -l lines (lsblk -d -n -p -o NAME,SIZE,MODEL | grep -v loop)
    test (count $lines) -eq 0; and ui_error "No disks found"; and return $STATUS_ERROR

    set -l menu
    for line in $lines
        set -l dev (echo $line | awk '{print $1}')
        set -l info (echo $line | awk '{$1=""; print substr($0,2)}')
        set -a menu $dev "$info"
    end

    dialog_run --title "Select Disk" --menu "Target disk (WILL BE ERASED):" 15 60 5 $menu
    test $status -ne $STATUS_OK; and return $STATUS_CANCEL
    test -b $DIALOG_RESULT; or begin; ui_error "Invalid device"; return $STATUS_ERROR; end

    set -g SELECTED_DISK $DIALOG_RESULT
    return $STATUS_OK
end

# --- Host Selection ---

function select_host
    set -g SELECTED_HOST ""

    dialog_run --title "Select Host" --menu "Configuration:" 14 55 4 \
        "vm" "Virtual machine" \
        "ideapad" "Lenovo IdeaPad" \
        "p1gen8" "ThinkPad P1 Gen 8" \
        "new" "New host (auto-detect)"
    test $status -ne $STATUS_OK; and return $STATUS_CANCEL

    if test "$DIALOG_RESULT" = "new"
        dialog_run --title "Hostname" --inputbox "Enter hostname:" 8 45 (get_default_hostname)
        test $status -ne $STATUS_OK; and return $STATUS_CANCEL
        set -g SELECTED_HOST $DIALOG_RESULT
    else
        set -g SELECTED_HOST $DIALOG_RESULT
    end
    return $STATUS_OK
end

# --- Password ---

function get_password
    set -g ENTERED_PASSWORD ""
    set -l user $argv[1]

    while true
        dialog_run --title "Password" --insecure --passwordbox "Password for $user:" 8 45
        test $status -ne $STATUS_OK; and return $STATUS_CANCEL
        set -l p1 $DIALOG_RESULT

        dialog_run --title "Confirm" --insecure --passwordbox "Confirm password:" 8 45
        test $status -ne $STATUS_OK; and return $STATUS_CANCEL
        set -l p2 $DIALOG_RESULT

        test "$p1" = "$p2"; and set -g ENTERED_PASSWORD $p1; and return $STATUS_OK
        ui_msg "Error" "Passwords don't match" 6 35
    end
end

# --- Flake Preparation ---

function prepare_flake
    set -l host $argv[1]

    ui_info "Cloning repository..."
    rm -rf $WORK_DIR
    mkdir -p $WORK_DIR $LOG_DIR

    if not check_network
        ui_error "No network connection"
        return $STATUS_ERROR
    end

    log "Cloning $REMOTE_REPO"
    if not git clone --depth 1 --recurse-submodules $REMOTE_REPO $WORK_DIR
        ui_error "Failed to clone repository"
        return $STATUS_ERROR
    end

    mkdir -p $WORK_DIR/hosts/$host
    log "Flake ready"
    return $STATUS_OK
end

function generate_host_config
    set -l host $argv[1]
    set -l user $argv[2]

    echo "{ config, pkgs, ... }:
{
  imports = [ ./hardware.nix ];
  networking.hostName = \"$host\";

  users.users.$user = {
    isNormalUser = true;
    extraGroups = [ \"wheel\" \"networkmanager\" ];
  };

  services.openssh.enable = true;
  networking.networkmanager.enable = true;
  system.stateVersion = \"25.11\";
}" > $WORK_DIR/hosts/$host/default.nix
end

# --- Installation ---

function execute_install
    set -l device $argv[1]
    set -l host $argv[2]
    set -l user $argv[3]
    set -l pass $argv[4]

    mkdir -p $LOG_DIR
    echo "=== Install started "(date -Iseconds)" ===" > $LOG_FILE
    log "Device: $device | Host: $host | User: $user"

    # 1. Partition
    log "=== Partitioning ==="
    if not sudo nix run github:nix-community/disko -- --mode destroy,format,mount --arg device "\"$device\"" /etc/nixpille/disko/standard.nix
        ui_error "Partitioning failed"
        return $STATUS_ERROR
    end

    # Verify mounts
    if not mountpoint -q /mnt
        ui_error "/mnt not mounted"
        return $STATUS_ERROR
    end
    if test -d /sys/firmware/efi; and not mountpoint -q /mnt/boot
        ui_error "/mnt/boot not mounted (EFI)"
        return $STATUS_ERROR
    end
    log "Mounts OK"

    # 2. Prepare flake
    log "=== Preparing flake ==="
    if not prepare_flake $host
        return $STATUS_ERROR
    end

    # 3. Generate configs
    log "=== Generating configs ==="
    if not sudo nixos-generate-config --root /mnt --show-hardware-config > $WORK_DIR/hosts/$host/hardware.nix
        ui_error "Failed to generate hardware.nix"
        return $STATUS_ERROR
    end

    if not is_predefined_host $host
        generate_host_config $host $user
        log "Generated config for new host"
    end

    pushd $WORK_DIR; git add -A; popd

    # 4. Verify
    log "=== Verifying ==="
    if not nix build "$WORK_DIR#nixosConfigurations.$host.config.system.build.toplevel" --dry-run
        ui_error "Configuration failed to evaluate"
        return $STATUS_ERROR
    end

    # 5. Install
    log "=== Installing ==="
    set -l opts
    if test -f /etc/nixpille/cache.env
        source_env /etc/nixpille/cache.env
        test -n "$EXTRA_SUBSTITUTERS"; and set -a opts --option extra-substituters "$EXTRA_SUBSTITUTERS"
        test -n "$EXTRA_TRUSTED_KEYS"; and set -a opts --option extra-trusted-public-keys "$EXTRA_TRUSTED_KEYS"
    end

    if not sudo nixos-install --flake "$WORK_DIR#$host" --no-root-passwd --no-channel-copy $opts
        ui_error "Installation failed"
        return $STATUS_ERROR
    end

    # 6. Setup config repo
    log "=== Setting up config ==="
    sudo mkdir -p /mnt/home/$user/Dev
    sudo cp -a $WORK_DIR /mnt/home/$user/Dev/nixpille
    sudo chown -R 1000:1000 /mnt/home/$user/Dev
    sudo ln -sfn /home/$user/Dev/nixpille /mnt/etc/nixos

    # 7. Set password
    log "=== Setting password ==="
    if not sudo nixos-enter --root /mnt -c "echo '$user:$pass' | chpasswd"
        ui_error "Failed to set password"
        return $STATUS_ERROR
    end

    log "=== Complete ==="
    sudo cp $LOG_FILE /mnt/var/log/nixpille-install.log 2>/dev/null
    return $STATUS_OK
end

# --- Wizard ---

function install_wizard
    set -l step 1
    set -l device ""
    set -l host ""
    set -l user "javad"
    set -l pass ""

    while test $step -le 4
        switch $step
            case 1
                select_disk; or return $STATUS_CANCEL
                set device $SELECTED_DISK
                set step 2
            case 2
                select_host
                test $status -ne $STATUS_OK; and set step 1; and continue
                set host $SELECTED_HOST
                set step 3
            case 3
                get_password $user
                test $status -ne $STATUS_OK; and set step 2; and continue
                set pass $ENTERED_PASSWORD
                set step 4
            case 4
                dialog_run --title "Confirm" --yesno "Install NixOS?\n\n  Disk: $device\n  Host: $host\n  User: $user" 11 45
                test $status -ne $STATUS_OK; and set step 3; and continue
                break
        end
    end

    execute_install $device $host $user $pass
    return $status
end

# --- Main Menu ---

function main_menu
    while true
        dialog_run --title "Menu" --menu "" 14 50 5 \
            "install" "Install NixOS" \
            "network" "Configure network" \
            "hardware" "Show hardware" \
            "log" "View log" \
            "shell" "Exit to shell"

        if test $status -ne $STATUS_OK
            dialog_run --yesno "Exit?" 6 25
            test $status -eq $STATUS_OK; and return
            continue
        end

        switch $DIALOG_RESULT
            case install
                install_wizard
                if test $status -eq $STATUS_OK
                    dialog_run --yesno "Done! View log?" 7 30
                    test $status -eq $STATUS_OK; and show_log
                    ui_msg "Complete" "Remove media and reboot" 7 35
                    return
                else
                    dialog_run --yesno "Failed. View log?" 7 30
                    test $status -eq $STATUS_OK; and show_log
                end
            case network
                configure_network
            case hardware
                show_hardware
            case log
                test -f $LOG_FILE; and show_log; or ui_msg "No Log" "No log yet" 6 30
            case shell
                return
        end
    end
end

function main
    # Initial network setup
    if not check_network
        dialog_run --title "Welcome" --yesno "Network required.\n\nConfigure now?" 8 40
        test $status -eq $STATUS_OK; and configure_network
    end

    main_menu
    clear
    echo "Log: $LOG_FILE"
end

# Wrap in script for logging
if not set -q NIXPILLE_LOGGING
    mkdir -p $LOG_DIR
    set -gx NIXPILLE_LOGGING 1
    exec script -a $LOG_FILE -c "fish "(status filename)
end

main
