#!/usr/bin/env fish
#
# secrets - Secrets management CLI via Bitwarden and GNOME Keyring
#
# Usage: secrets [OPTIONS] <COMMAND>

set -g SECRETS_VERSION "2.0.0"

# Find library directory
if not set -q SECRETS_LIB_DIR
    set -g SECRETS_LIB_DIR (dirname (status filename))
end

# Source libraries in order
source $SECRETS_LIB_DIR/lib/core.fish
source $SECRETS_LIB_DIR/config.fish
source $SECRETS_LIB_DIR/lib/pinentry.fish
source $SECRETS_LIB_DIR/lib/keyring.fish
source $SECRETS_LIB_DIR/lib/runtime.fish
source $SECRETS_LIB_DIR/lib/bw.fish
source $SECRETS_LIB_DIR/modules/ssh.fish
source $SECRETS_LIB_DIR/modules/gpg.fish
source $SECRETS_LIB_DIR/modules/files.fish

# === Main Commands ===

function cmd_pull
    # Pull all secrets from Bitwarden
    section "Pulling from Bitwarden"

    config_validate || return 1
    bw_session || return 1

    section "Files"
    files_pull

    section "SSH Keys"
    ssh_pull

    section "GPG Keys"
    gpg_pull

    echo ""
    log_success "Pull complete"
end

function cmd_export
    # Export from keyring to filesystem (offline)
    section "Exporting from Keyring"

    section "Files"
    files_export

    # Also export age key to sops dir
    set -l age_key (keyring_get_age_key)
    if test -n "$age_key"
        set -l sops_dir (runtime_ensure sops)
        printf '%s' "$age_key" > $sops_dir/keys.txt
        chmod 600 $sops_dir/keys.txt
        item_ok "age key" "$sops_dir/keys.txt"
    end

    echo ""
    log_success "Export complete (offline)"
end

function cmd_sync
    # Sync files back to Bitwarden
    section "Syncing to Bitwarden"
    config_validate || return 1
    files_sync
end

function cmd_status
    # Show status of all secrets
    section "Status"
    echo ""

    bw_show_status
    echo ""

    echo "Keyring:"
    echo -n "  BW session: "
    test -n (keyring_get_bw_session) && echo "cached" || echo "none"
    echo -n "  Age key: "
    test -n (keyring_get_age_key) && echo "present" || echo "missing"
    echo ""

    files_status
    echo ""
    ssh_status
    echo ""
    gpg_status
end

function cmd_lock
    # Clear all secrets from memory
    section "Locking"

    # Clear SSH agent
    ssh-add -D 2>/dev/null
    item_ok "SSH agent" "cleared"

    # Shred tmpfs secrets
    runtime_shred wireguard
    runtime_shred kube
    runtime_shred sops
    runtime_shred ssh
    runtime_shred gpg-import
    item_ok "tmpfs" "cleared"

    # Lock Bitwarden
    if test -n "$SECRETS_BW_CLI"
        bw_lock 2>/dev/null
    end

    echo ""
    log_success "Locked"
end

function cmd_login
    # Login/unlock Bitwarden
    config_validate || return 1
    bw_login
end

function cmd_config
    config_show
end

function cmd_sops_edit
    # Edit sops secrets file
    set -l key (keyring_get_age_key)
    if test -z "$key"
        log_error "No age key in keyring"
        log_info "Run 'secrets pull' first"
        return 1
    end

    set -l sops_dir (runtime_ensure sops)
    printf '%s' "$key" > $sops_dir/keys.txt
    chmod 600 $sops_dir/keys.txt

    # Find secrets file (relative to script or provided)
    set -l secrets_file $argv[1]
    if test -z "$secrets_file"
        # Try common locations
        for f in ./hosts/common/secrets/secrets.yaml ./secrets.yaml
            if test -f $f
                set secrets_file $f
                break
            end
        end
    end

    if test -z "$secrets_file" -o ! -f "$secrets_file"
        log_error "Secrets file not found"
        log_info "Usage: secrets sops edit [path/to/secrets.yaml]"
        return 1
    end

    log_info "Editing: $secrets_file"
    SOPS_AGE_KEY_FILE=$sops_dir/keys.txt sops $secrets_file
end

function cmd_sops_show
    # Decrypt and show sops secrets
    set -l key (keyring_get_age_key)
    if test -z "$key"
        log_error "No age key in keyring"
        return 1
    end

    set -l sops_dir (runtime_ensure sops)
    printf '%s' "$key" > $sops_dir/keys.txt
    chmod 600 $sops_dir/keys.txt

    set -l secrets_file $argv[1]
    if test -z "$secrets_file"
        for f in ./hosts/common/secrets/secrets.yaml ./secrets.yaml
            if test -f $f
                set secrets_file $f
                break
            end
        end
    end

    if test -z "$secrets_file" -o ! -f "$secrets_file"
        log_error "Secrets file not found"
        return 1
    end

    SOPS_AGE_KEY_FILE=$sops_dir/keys.txt sops -d $secrets_file
end

# === CLI Router ===

function show_help
    echo "secrets $SECRETS_VERSION - Secrets management via Bitwarden and GNOME Keyring"
    echo ""
    echo "Usage: secrets [OPTIONS] <COMMAND>"
    echo ""
    echo "Options:"
    echo "  -v, --verbose    Enable debug output"
    echo "  -q, --quiet      Only show errors"
    echo "  --no-color       Disable colors"
    echo "  --version        Show version"
    echo "  -h, --help       Show help"
    echo ""
    echo "Commands:"
    echo "  pull             Pull all secrets from Bitwarden"
    echo "  export           Export from keyring to filesystem (offline)"
    echo "  sync             Sync files back to Bitwarden"
    echo "  status           Show status of all secrets"
    echo "  lock             Clear all secrets from memory"
    echo "  login            Login/unlock Bitwarden"
    echo "  config           Show configuration"
    echo ""
    echo "  ssh pull         Pull SSH keys to agent"
    echo "  ssh add <file>   Add SSH key to Bitwarden"
    echo "  ssh rm <name>    Remove SSH key from Bitwarden"
    echo "  ssh list         List SSH keys in Bitwarden"
    echo "  ssh status       Show SSH agent status"
    echo ""
    echo "  gpg pull         Pull GPG keys to keyring"
    echo "  gpg add <keyid>  Add GPG key to Bitwarden"
    echo "  gpg rm <name>    Remove GPG key from Bitwarden"
    echo "  gpg list         List GPG keys in Bitwarden"
    echo "  gpg status       Show GPG keyring status"
    echo ""
    echo "  files pull       Pull files to keyring + filesystem"
    echo "  files export     Export files from keyring (offline)"
    echo "  files sync       Sync files to Bitwarden"
    echo "  files add <src> <dest>  Add file to Bitwarden"
    echo "  files rm <name>  Remove file from Bitwarden"
    echo "  files list       List files in Bitwarden"
    echo "  files status     Show file status"
    echo ""
    echo "  sops edit [file] Edit sops secrets file"
    echo "  sops show [file] Show decrypted sops secrets"
    echo ""
    echo "Environment variables:"
    echo "  SECRETS_BW_CLI          Bitwarden CLI command"
    echo "  SECRETS_LOG_LEVEL       Log level (debug, info, warn, error)"
    echo "  SECRETS_NO_COLOR        Disable colors"
    echo "  SECRETS_KEYRING_SERVICE Keyring service name (default: nixpille)"
end

function main
    # Parse global options
    while true
        switch $argv[1]
            case -v --verbose
                set -g SECRETS_LOG_LEVEL debug
                set -e argv[1]
            case -q --quiet
                set -g SECRETS_LOG_LEVEL error
                set -e argv[1]
            case --no-color
                set -g SECRETS_NO_COLOR 1
                _init_colors  # Reinit with no colors
                set -e argv[1]
            case --version
                echo "secrets $SECRETS_VERSION"
                return 0
            case -h --help
                show_help
                return 0
            case '*'
                break
        end
    end

    # Get command
    set -l cmd $argv[1]
    set -e argv[1]

    switch $cmd
        case pull
            cmd_pull
        case export
            cmd_export
        case sync
            cmd_sync
        case status
            cmd_status
        case lock
            cmd_lock
        case login
            cmd_login
        case config
            cmd_config

        case ssh
            set -l subcmd $argv[1]
            set -e argv[1]
            switch $subcmd
                case pull
                    bw_session && ssh_pull
                case add
                    ssh_add $argv
                case rm
                    ssh_rm $argv
                case list
                    ssh_list
                case status
                    ssh_status
                case ''
                    ssh_status
                case '*'
                    log_error "Unknown ssh command: $subcmd"
                    return 1
            end

        case gpg
            set -l subcmd $argv[1]
            set -e argv[1]
            switch $subcmd
                case pull
                    bw_session && gpg_pull
                case add
                    gpg_add $argv
                case rm
                    gpg_rm $argv
                case list
                    gpg_list
                case status
                    gpg_status
                case ''
                    gpg_status
                case '*'
                    log_error "Unknown gpg command: $subcmd"
                    return 1
            end

        case files
            set -l subcmd $argv[1]
            set -e argv[1]
            switch $subcmd
                case pull
                    bw_session && files_pull
                case export
                    files_export
                case sync
                    files_sync
                case add
                    files_add $argv
                case rm
                    files_rm $argv
                case list
                    files_list
                case status
                    files_status
                case ''
                    files_status
                case '*'
                    log_error "Unknown files command: $subcmd"
                    return 1
            end

        case sops
            set -l subcmd $argv[1]
            set -e argv[1]
            switch $subcmd
                case edit
                    cmd_sops_edit $argv
                case show
                    cmd_sops_show $argv
                case ''
                    log_error "Usage: secrets sops <edit|show> [file]"
                    return 1
                case '*'
                    log_error "Unknown sops command: $subcmd"
                    return 1
            end

        case ''
            show_help
        case '*'
            log_error "Unknown command: $cmd"
            echo "Run 'secrets --help' for usage"
            return 1
    end
end

main $argv
